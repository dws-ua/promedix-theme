{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Графіт (текст)",
          "color": "#1E2B31"
        },
        {
          "slug": "primary",
          "name": "Глибокий бірюзовий",
          "color": "#2C5A6A"
        },
        {
          "slug": "steel",
          "name": "Бірюзовий",
          "color": "#3E6F80"
        },
        {
          "slug": "primary-dark",
          "name": "Бірюзовий темний",
          "color": "#214756"
        },
        {
          "slug": "mint",
          "name": "Небесний (банери)",
          "color": "#E7F0F8"
        },
        {
          "slug": "beige",
          "name": "Блакитний (тло фото)",
          "color": "#D0E5F8"
        },
        {
          "slug": "mint-deep",
          "name": "Світло-блакитний",
          "color": "#EEF4F9"
        },
        {
          "slug": "surface",
          "name": "Біле тло",
          "color": "#FFFFFF"
        },
        {
          "slug": "line",
          "name": "Лінія",
          "color": "#E2EAF0"
        },
        {
          "slug": "line-strong",
          "name": "Лінія полів",
          "color": "#C9D7E2"
        },
        {
          "slug": "muted",
          "name": "Приглушений текст",
          "color": "#65737A"
        },
        {
          "slug": "body",
          "name": "Основний текст",
          "color": "#3D4A51"
        },
        {
          "slug": "accent",
          "name": "Жовтий акцент",
          "color": "#F2C230"
        },
        {
          "slug": "on-dark",
          "name": "Текст на темному",
          "color": "#E7F0F8"
        },
        {
          "slug": "white",
          "name": "Білий",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Montserrat",
          "fontFamily": "Montserrat, 'Helvetica Neue', Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "13px",
          "fluid": false
        },
        {
          "slug": "sm",
          "name": "S",
          "size": "15px",
          "fluid": false
        },
        {
          "slug": "md",
          "name": "M",
          "size": "16px",
          "fluid": false
        },
        {
          "slug": "lg",
          "name": "L",
          "size": "18px",
          "fluid": false
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "24px",
          "fluid": {
            "min": "20px",
            "max": "24px"
          }
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "34px",
          "fluid": {
            "min": "28px",
            "max": "34px"
          }
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "48px",
          "fluid": {
            "min": "34px",
            "max": "48px"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "8px"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "16px"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "24px"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "40px"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "clamp(48px, 6vw, 72px)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "pill": "4px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.55"
    },
    "spacing": {
      "padding": {
        "left": "24px",
        "right": "24px"
      },
      "blockGap": "24px"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--steel)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.12",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "600"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "6px"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--md)"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "28px",
            "right": "28px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--line)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "500"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Шапка",
      "area": "header"
    },
    {
      "name": "header-checkout",
      "title": "Шапка оформлення",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Футер",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-b2b",
      "title": "Для закладів і партнерів",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-full",
      "title": "На всю ширину без заголовка",
      "postTypes": [
        "page"
      ]
    }
  ]
}