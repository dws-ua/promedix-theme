{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Заголовки",
          "color": "#142D38"
        },
        {
          "slug": "body",
          "name": "Основний текст",
          "color": "#263F4A"
        },
        {
          "slug": "muted",
          "name": "Приглушений текст",
          "color": "#506570"
        },
        {
          "slug": "primary",
          "name": "Основний (кнопки)",
          "color": "#286071"
        },
        {
          "slug": "primary-dark",
          "name": "Наведення",
          "color": "#204D5B"
        },
        {
          "slug": "primary-active",
          "name": "Натиснення",
          "color": "#183D49"
        },
        {
          "slug": "steel",
          "name": "Монохромний бренд",
          "color": "#5E8395"
        },
        {
          "slug": "dark-section",
          "name": "Темна секція",
          "color": "#204D5B"
        },
        {
          "slug": "surface",
          "name": "Біле тло",
          "color": "#FFFFFF"
        },
        {
          "slug": "subtle",
          "name": "Тло світле",
          "color": "#F5F9FB"
        },
        {
          "slug": "mint",
          "name": "Тло акцентне",
          "color": "#EAF3F7"
        },
        {
          "slug": "beige",
          "name": "Тло фото товару",
          "color": "#E1EDF3"
        },
        {
          "slug": "line",
          "name": "Лінія",
          "color": "#D6E3E9"
        },
        {
          "slug": "line-strong",
          "name": "Рамка полів",
          "color": "#748B96"
        },
        {
          "slug": "accent",
          "name": "Жовтий акцент",
          "color": "#F4D85E"
        },
        {
          "slug": "success",
          "name": "Успіх",
          "color": "#237553"
        },
        {
          "slug": "error",
          "name": "Помилка",
          "color": "#B42332"
        },
        {
          "slug": "brand-blue",
          "name": "Бренд синій",
          "color": "#1D9CD7"
        },
        {
          "slug": "brand-red",
          "name": "Бренд червоний",
          "color": "#E32124"
        },
        {
          "slug": "white",
          "name": "Білий",
          "color": "#FFFFFF"
        },
        {
          "slug": "on-dark",
          "name": "Текст на темному",
          "color": "#FFFFFF"
        },
        {
          "slug": "mint-deep",
          "name": "Тло акцентне (дубль)",
          "color": "#EAF3F7"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Manrope",
          "fontFamily": "Manrope, system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "Manrope",
          "fontFamily": "Manrope, system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "sm",
          "name": "S",
          "size": "0.9375rem",
          "fluid": false
        },
        {
          "slug": "md",
          "name": "M",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "lg",
          "name": "L",
          "size": "1.25rem",
          "fluid": false
        },
        {
          "slug": "xl",
          "name": "H3",
          "size": "1.5rem",
          "fluid": false
        },
        {
          "slug": "2xl",
          "name": "H2",
          "size": "clamp(1.75rem, 1.2rem + 1.6vw, 2.25rem)",
          "fluid": false
        },
        {
          "slug": "3xl",
          "name": "H1",
          "size": "clamp(2.25rem, 1.4rem + 2.6vw, 3rem)",
          "fluid": false
        },
        {
          "slug": "hero",
          "name": "Hero",
          "size": "clamp(2.5rem, 1.3rem + 3.6vw, 4rem)",
          "fluid": false
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "8",
          "size": "8px"
        },
        {
          "slug": "30",
          "name": "12",
          "size": "12px"
        },
        {
          "slug": "40",
          "name": "16",
          "size": "16px"
        },
        {
          "slug": "50",
          "name": "24",
          "size": "24px"
        },
        {
          "slug": "60",
          "name": "40",
          "size": "40px"
        },
        {
          "slug": "70",
          "name": "80",
          "size": "clamp(48px, 6vw, 80px)"
        }
      ]
    },
    "border": {
      "radius": true
    },
    "custom": {
      "radius": {
        "sm": "4px",
        "md": "6px",
        "lg": "8px",
        "pill": "4px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--body)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.625"
    },
    "spacing": {
      "padding": {
        "left": "clamp(16px, 3vw, 32px)",
        "right": "clamp(16px, 3vw, 32px)"
      },
      "blockGap": "24px"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "800",
          "lineHeight": "1.17",
          "letterSpacing": "-0.03em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "lineHeight": "1.22",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "lineHeight": "1.33"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "1rem",
          "lineHeight": "1.5"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--line)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "500"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Шапка",
      "area": "header"
    },
    {
      "name": "header-checkout",
      "title": "Шапка оформлення",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Футер",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-b2b",
      "title": "Для команд",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-full",
      "title": "На всю ширину без заголовка",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-profession",
      "title": "Сторінка професії",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-about",
      "title": "Про бренд",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-help",
      "title": "Допомога покупцю",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-contacts",
      "title": "Контакти",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-service",
      "title": "Сервісна сторінка (кошик, оформлення, кабінет)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-landing",
      "title": "SEO-сторінка професії",
      "postTypes": [
        "page"
      ]
    }
  ]
}
